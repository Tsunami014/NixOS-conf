// "/-" comments out the following node (no need for ending)
// https://yalter.github.io/niri/Configuration:-Introduction

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

include "keys.kdl"
include "windowRules.kdl"
include optional=true "~/.niriextra/autorotate.kdl"
include optional=true "~/.niriextra/animations.kdl"

spawn-at-startup "systemctl" "--user" "import-environment" "WAYLAND_DISPLAY" "XDG_RUNTIME_DIR"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "DISPLAY" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "XDG_SESSION_TYPE"
spawn-at-startup "systemctl" "--user" "restart" "xdg-desktop-portal.service" "xdg-desktop-portal-gnome.service"
spawn-at-startup "~/.,sysfiles/,startup.sh"

// Input device configuration.
// https://yalter.github.io/niri/Configuration:-Input
input {
    disable-power-key-handling

    keyboard {
        numlock
        xkb {
            layout "au"
        }
    }

    touchpad {
        tap  // Tap to click
        // dwt  // Disable when typing
        // dwtp  // Disable when trackpointing
        natural-scroll  // Invert scroll direction
        // accel-speed 0.2  // From -1 to 1, default 0
        // disabled-on-external-mouse
    }

    mouse {}

    // warp-mouse-to-focus  // Warp to the centre of newly focused windows
    // focus-follows-mouse  // Focus windows when moving the mouse over them

    workspace-auto-back-and-forth
}

gestures {
    hot-corners {
        off
    }
}

// https://yalter.github.io/niri/Configuration:-Layout
layout {
    gaps 16 // Gap around windows (pixels)

    always-center-single-column
    empty-workspace-above-first
    default-column-display "tabbed"

    preset-column-widths {
        proportion 0.33333
        proportion 0.50
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.7
        proportion 1.0
    }

    default-column-width { proportion 0.80; }


    focus-ring {
        width 4

        active-gradient from="#f7768e" to="#9ece6a" angle=45 relative-to="workspace-view" in="oklch longer hue"
        inactive-gradient from="#cfc9c2" to="#9aa5ce" angle=-45 relative-to="workspace-view"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column

        gaps-between-tabs 2
        length total-proportion=0.7

        active-color "#e0af68"
        inactive-color "#cfc9c2"
        urgent-color "#f7768e"
    }

    shadow {
        on
        softness 0  // Blur radius
        spread 5  // Expands the shadow
        offset x=5 y=5  // Moves the shadow relative to the window
        color "#0007"
    }

    insert-hint {
        color "#7aa2f780"
    }

    // Because the windows are sometimes 1 pixel in from the edge, annoyingly
    struts {
        left -1
        right -1
        top -1
        bottom -1
    }
}
window-rule {
    match is-window-cast-target=true

    focus-ring { off; }

    shadow {
        on
        offset x=0 y=0
        softness 0
        spread 4
        color "#FC5BA7"
    }
}

recent-windows {
    debounce-ms 750 // Delay between selecting a window and having it in the 'recent windows' list
    highlight {
        corner-radius 25
    }
}

hotkey-overlay {
    skip-at-startup
}

// Overrides
include optional=true "~/.local/state/theme/current/niri.kdl"
