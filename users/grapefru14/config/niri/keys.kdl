// run `niri msg action` to see avaliable commands
environment {
    TermSpawn "alacritty -e"
    EXECUTE "hexecute"
}
binds {
    XF86PowerOff { spawn "wlogout"; }

    // Apps / User stuff
    Mod+MouseMiddle repeat=false hotkey-overlay-title="Hexecute" { spawn-sh "$EXECUTE"; }
    Mod+Ctrl+MouseMiddle repeat=false hotkey-overlay-title="Apps menu" { spawn-sh "kando -t apps"; }
    Mod+Ctrl+P repeat=false hotkey-overlay-title="Pointer" { spawn-sh "HOME='/tmp';hexecute"; }

    Mod+Return repeat=false hotkey-overlay-title="Terminal" { spawn "alacritty"; }
    Mod+D repeat=false hotkey-overlay-title="Downloads" { spawn-sh "$TermSpawn bash -ic 'downloads; yazi'"; }
    Mod+N repeat=false hotkey-overlay-title="Neovim" { spawn-sh "$TermSpawn nvim"; }
    Mod+Shift+N repeat=false hotkey-overlay-title="Neovim" { spawn-sh "NVIM_PROFILE=choose $TermSpawn nvim"; }
    Mod+Apostrophe repeat=false hotkey-overlay-title="File browser" { spawn-sh "$TermSpawn yazi"; }
    Mod+Semicolon repeat=false hotkey-overlay-title="Notes viewer" { spawn-sh "mkdir -p ~/Notes;NVIM_PROFILE=Notes $TermSpawn yazi ~/Notes"; }
    Mod+I repeat=false hotkey-overlay-title="Index file" { spawn-sh "cd ~/Notes/; NVIM_PROFILE=Notes $TermSpawn nvim ./+index.md"; }
    Mod+H repeat=false hotkey-overlay-title="Htop" { spawn-sh "$TermSpawn htop"; }
    Mod+J repeat=false hotkey-overlay-title="Japanese" { spawn-sh "$TermSpawn jap"; }
    Mod+T repeat=false hotkey-overlay-title="Temp place" { spawn-sh "$TermSpawn bash -ic mktmpplace"; }
    Mod+P repeat=false hotkey-overlay-title="Temporary python" { spawn-sh "$TermSpawn bash -ic 'py'"; }
    Mod+L repeat=false hotkey-overlay-title="Open link file" { spawn-sh "$TermSpawn linkfile"; }
    Mod+W repeat=false hotkey-overlay-title="Choose wallpaper" { spawn-sh "$TermSpawn wallppr"; }

    Mod+B repeat=false hotkey-overlay-title="Web browser" { spawn "zen"; }
    Mod+Shift+B repeat=false hotkey-overlay-title="Private web browser" { spawn-sh "zen --private-window"; }

    Mod+V repeat=false hotkey-overlay-title="Clipboard history" { spawn "cliphist-fuzzel-img"; }
    Mod+Shift+P repeat=false hotkey-overlay-title="Colour picker" { spawn "wl-color-picker"; }

    Mod+S repeat=false hotkey-overlay-title="SSH" { spawn-sh "$TermSpawn ssh tsunami@192.168.1.129"; }
    Mod+Shift+S repeat=false hotkey-overlay-title="Sapla" { spawn "~/Documents/Sapla/out/Sapla-x86_64.AppImage"; }

    Mod+Alt+B repeat=false hotkey-overlay-title="Change background" { spawn-sh "wallppr rand"; }


    // Misc stuff
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
        // In case something needs to use keybinds taken by niri

    Mod+Control+Shift+Escape { quit; }
    Mod+Control+Shift+Delete { spawn-sh "$TermSpawn sh -c 'close; read -rs -p \"\nPress any key\"'"; }

    Mod+F1 { show-hotkey-overlay; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Grave { power-off-monitors; }  // To turn back on do anything
    Mod+Space repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }


    // Window moving
    Mod+Comma  { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }
    Mod+Slash { toggle-column-tabbed-display; }
    Mod+Shift+Comma  { consume-or-expel-window-left; }
    Mod+Shift+Period { consume-or-expel-window-right; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+C { center-column; }
    Mod+Shift+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Backspace { set-window-height "+0%"; }

    Mod+X { switch-focus-between-floating-and-tiling; }
    Mod+Shift+X { toggle-window-floating; }


    // "Dynamic casting" (when screen casting, it's the window "niri Dynamic Cast Target")
    Mod+E hotkey-overlay-title="Cast focused window" { set-dynamic-cast-window; }
    Mod+Shift+E { set-dynamic-cast-monitor; }
    Mod+Ctrl+E { clear-dynamic-cast-target; }

    // Streaming stuff
    Mod+O { spawn "obs-scene-pick"; }


    // The do stuff buttons
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }


    // When moving up/down one workspace, move the window to detach it if in a group. Otherwise, assume moving the whole column.
    // Window focus (no modifier)
    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Ctrl+H { focus-column-or-monitor-left; }
    Mod+Ctrl+J { focus-window-or-workspace-down; }
    Mod+Ctrl+K { focus-window-or-workspace-up; }
    Mod+Ctrl+L { focus-column-or-monitor-right; }

    // Window movement (shift)
    Mod+Shift+Left  { move-column-left-or-to-monitor-left; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-left-or-to-monitor-left; }
    Mod+Ctrl+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+Shift+K { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Shift+L { move-column-right-or-to-monitor-right; }

    // New workspace/monitor focus (ctrl)
    Mod+Ctrl+Left  repeat=false { focus-monitor-left; }
    Mod+Ctrl+Down  repeat=false { spawn-sh "~/.config/niri/rel_ws.sh 1"; }
    Mod+Ctrl+Up    repeat=false { spawn-sh "~/.config/niri/rel_ws.sh 0"; }
    Mod+Ctrl+Right repeat=false { focus-monitor-right; }

    // New workspace/monitor movement (ctrl+shift)
    Mod+Ctrl+Shift+Left  repeat=false { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Down  repeat=false { spawn-sh "~/.config/niri/rel_ws.sh 1 --take"; }
    Mod+Ctrl+Shift+Up    repeat=false { spawn-sh "~/.config/niri/rel_ws.sh 0 --take"; }
    Mod+Ctrl+Shift+Right repeat=false { move-column-to-monitor-right; }

    // Workspace focus (fn)
    Mod+Home      repeat=false { focus-column-first; }
    Mod+Page_Down repeat=false { focus-workspace-down; }
    Mod+Page_Up   repeat=false { focus-workspace-up; }
    Mod+End       repeat=false { focus-column-last; }

    // Workspace movement (fn+shift)
    Mod+Shift+Home      repeat=false { move-column-to-first; }
    Mod+Shift+Page_Down repeat=false { move-window-to-workspace-down; }
    Mod+Shift+Page_Up   repeat=false { move-window-to-workspace-up; }
    Mod+Shift+End       repeat=false { move-column-to-last; }

    // Start/end focus (fn/numbers)
    Mod+1 repeat=false { focus-workspace 1; }
    Mod+2 repeat=false { focus-workspace 2; }
    Mod+3 repeat=false { focus-workspace 3; }
    Mod+4 repeat=false { focus-workspace 4; }
    Mod+5 repeat=false { focus-workspace 5; }
    Mod+6 repeat=false { spawn-sh "~/.config/niri/lastwsAction.sh focus-workspace 4"; }
    Mod+7 repeat=false { spawn-sh "~/.config/niri/lastwsAction.sh focus-workspace 3"; }
    Mod+8 repeat=false { spawn-sh "~/.config/niri/lastwsAction.sh focus-workspace 2"; }
    Mod+9 repeat=false { spawn-sh "~/.config/niri/lastwsAction.sh focus-workspace 1"; }
    Mod+0 repeat=false { focus-workspace 255; }

    // Move to start/end (fn+shift)
    Mod+Shift+1 repeat=false { move-column-to-workspace 1; }
    Mod+Shift+2 repeat=false { move-column-to-workspace 2; }
    Mod+Shift+3 repeat=false { move-column-to-workspace 3; }
    Mod+Shift+4 repeat=false { move-column-to-workspace 4; }
    Mod+Shift+5 repeat=false { move-column-to-workspace 5; }
    Mod+Shift+6 repeat=false { spawn-sh "~/.config/niri/lastwsAction.sh move-column-to-workspace 4"; }
    Mod+Shift+7 repeat=false { spawn-sh "~/.config/niri/lastwsAction.sh move-column-to-workspace 3"; }
    Mod+Shift+8 repeat=false { spawn-sh "~/.config/niri/lastwsAction.sh move-column-to-workspace 2"; }
    Mod+Shift+9 repeat=false { spawn-sh "~/.config/niri/lastwsAction.sh move-column-to-workspace 1"; }
    Mod+Shift+0 repeat=false { move-column-to-workspace 255; }

    // Touchpad scrolling through windows
    Mod+TouchpadScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+TouchpadScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+TouchpadScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+TouchpadScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+TouchpadScrollRight cooldown-ms=150 { focus-column-right; }
    Mod+TouchpadScrollLeft  cooldown-ms=150 { focus-column-left; }
    Mod+Ctrl+TouchpadScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+Ctrl+TouchpadScrollUp   cooldown-ms=150 { focus-column-left; }
    Mod+Shift+TouchpadScrollRight cooldown-ms=150 { move-column-right; }
    Mod+Shift+TouchpadScrollLeft  cooldown-ms=150 { move-column-left; }
    Mod+Shift+Ctrl+TouchpadScrollDown cooldown-ms=150 { move-column-right; }
    Mod+Shift+Ctrl+TouchpadScrollUp   cooldown-ms=150 { move-column-left; }


    // Misc workspace stuff
    Mod+Tab { focus-workspace-previous; }
    Mod+Shift+Tab { focus-workspace-previous; }
}
