layout {
    focus-ring {
        active-gradient from="{{red}}" to="{{green}}" angle=45 relative-to="workspace-view" in="oklch longer hue"
        inactive-gradient from="{{fg}}" to="{{muted1}}" angle=-45 relative-to="workspace-view"
    }
    tab-indicator {
        active-color "{{yellow}}"
        inactive-color "{{fg}}"
        urgent-color "{{red}}"
    }
}
